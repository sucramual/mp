# Personal secrets — copy to ~/.env (NOT tracked) and fill in real values.
#   cp .env.example ~/.env && chmod 600 ~/.env && $EDITOR ~/.env
#
# Sourced by zshrc; values are inherited by Claude Code launched from terminal.

# Slack bot token used by post-merge-followup skill (chat:write, im:write)
export SLACK_BOT_TOKEN=""

# Linear personal API key used by post-merge-followup, ticket-to-pr,
# and the platform GeneratePlatformRoadmap / GeneratePlatformFortnightly scripts
export LINEAR_API_KEY=""

# Notion integration token used by local scripts/agents when they need env auth.
export NOTION_API_KEY=""
export NOTION_TOKEN="$NOTION_API_KEY"
