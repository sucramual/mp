#!/bin/bash
# Devbox bootstrap step: install the verify-browser Chrome and its display tools. See config/devbox/README.md.
# It never prompts: apt runs through sudo -n. Exit 0 means done. A re-run installs only what is missing.
set -u

self="$(readlink -f "${BASH_SOURCE[0]}")"
exec "$(dirname "$self")/../verify-browser/verify-browser" install
