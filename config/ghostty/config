# Ghostty config — symlinked to ~/.config/ghostty/config by install.sh
# Reload in-app with Cmd+Shift+, (no restart needed for most keys).
#
# Tuned to match macOS Terminal.app's "Clear Dark"/"Clear Light" profiles.
# Themes live in config/ghostty/themes/ (symlinked to ~/.config/ghostty/themes).

# Font — SF Mono is Apple's terminal face, bundled inside Terminal.app.
# install.sh copies it into ~/Library/Fonts so Ghostty can see it.
# Terminal.app itself uses 12pt; 13 is the same face, slightly easier to read.
font-family = SF Mono
font-size = 13
font-thicken = true

# Chrome — Terminal.app sits tight to the edges and uses a native titlebar.
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
macos-titlebar-style = native

# Translucent, blurred background (Terminal.app: 95% opacity, blur 0.5)
background-opacity = 0.95
background-blur-radius = 20

# Blinking block cursor, as Terminal.app ships
cursor-style = block
cursor-style-blink = true

# Ergonomics
window-save-state = always
unfocused-split-opacity = 0.6
bell-features = system, attention, title
mouse-hide-while-typing = true
copy-on-select = clipboard
minimum-contrast = 1.1

# Follows macOS appearance (Auto): Clear Light by day, Clear Dark by night.
theme = light:terminal-clear-light,dark:terminal-clear-dark
