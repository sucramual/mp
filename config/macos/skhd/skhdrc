# Focus windows (ctrl + alt + vim keys)
ctrl + alt - h : yabai -m window --focus west
ctrl + alt - j : yabai -m window --focus south
ctrl + alt - k : yabai -m window --focus north
ctrl + alt - l : yabai -m window --focus east

# Swap windows (ctrl + shift + alt + vim keys)
ctrl + shift + alt - h : yabai -m window --swap west
ctrl + shift + alt - j : yabai -m window --swap south
ctrl + shift + alt - k : yabai -m window --swap north
ctrl + shift + alt - l : yabai -m window --swap east

# Toggle float for current window
ctrl + alt - space : yabai -m window --toggle float

# Toggle fullscreen zoom
ctrl + alt - f : yabai -m window --toggle zoom-fullscreen

# Switch spaces
ctrl + alt - 1 : yabai -m space --focus 1
ctrl + alt - 2 : yabai -m space --focus 2
ctrl + alt - 3 : yabai -m space --focus 3
ctrl + alt - 4 : yabai -m space --focus 4

# Move window to space
ctrl + shift + alt - 1 : yabai -m window --space 1
ctrl + shift + alt - 2 : yabai -m window --space 2
ctrl + shift + alt - 3 : yabai -m window --space 3
ctrl + shift + alt - 4 : yabai -m window --space 4

# Move window to next/prev space and follow it
ctrl + shift + alt - right : yabai -m window --space next && yabai -m space --focus next
ctrl + shift + alt - left  : yabai -m window --space prev && yabai -m space --focus prev

# Snap window to half of screen
ctrl + alt - left  : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 1:2:0:0:1:1
ctrl + alt - right : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 1:2:1:0:1:1
ctrl + alt - up    : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:1:0:0:1:1
ctrl + alt - down  : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:1:0:1:1:1

# Snap window to quarter of screen
ctrl + alt - u : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:2:0:0:1:1
ctrl + alt - i : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:2:1:0:1:1
ctrl + alt - n : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:2:0:1:1:1
ctrl + alt - m : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 2:2:1:1:1:1

# Fullscreen (floating)
ctrl + alt - return : yabai -m query --windows --window | jq -e '."is-floating" == false' && yabai -m window --toggle float; yabai -m window --grid 1:1:0:0:1:1

# Re-tile all windows in BSP
ctrl + alt - t : yabai -m space --layout bsp

# Balance window sizes
ctrl + alt - 0 : yabai -m space --balance
