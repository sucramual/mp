# Worktree navigation: jump into the worktree that owns a branch/ticket.
# Usage: wtcd ENG-1503  |  wtcd quizzical  |  wtcd (list all)
wtcd() {
  local query="$1"
  if [[ -z "$query" ]]; then
    git worktree list
    return 0
  fi

  local matches
  matches=$(git worktree list --porcelain | awk '
    /^worktree / { path=$2 }
    /^branch /   { sub("refs/heads/","",$2); print path "\t" $2 }
  ' | grep -i -- "$query")

  if [[ -z "$matches" ]]; then
    echo "wtcd: no worktree matching '$query'" >&2
    return 1
  fi

  local count=$(printf '%s\n' "$matches" | wc -l | tr -d ' ')
  if [[ "$count" -eq 1 ]]; then
    cd "$(printf '%s' "$matches" | cut -f1)"
  elif command -v fzf >/dev/null; then
    local picked=$(printf '%s\n' "$matches" | fzf --with-nth=2 --delimiter=$'\t')
    [[ -n "$picked" ]] && cd "$(printf '%s' "$picked" | cut -f1)"
  else
    printf '%s\n' "$matches" | awk -F'\t' '{print "  "$2" → "$1}'
    return 1
  fi
}

