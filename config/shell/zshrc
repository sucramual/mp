[ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"  # This loads nvm bash_completion

# Update vercel-labs skills CLI with auth for private repos
skills-update() {
  local token
  token=$(gh auth token 2>/dev/null)
  [[ -n $token ]] || token=${GH_TOKEN:-$GITHUB_TOKEN}
  [[ -n $token ]] || {
    echo "skills-update: no GitHub token found." >&2
    echo "  fix: gh auth login            # preferred — stores the token in the keychain" >&2
    echo "  or:  export GH_TOKEN=<token>  # fallback when gh is unavailable" >&2
    return 1
  }
  GH_TOKEN="$token" npx skills update -g "$@"
}

