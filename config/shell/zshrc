# gcloud SDK components (gke-gcloud-auth-plugin for kubectl) install here, not on the Homebrew PATH.
# zprofile's brew shellenv sets HOMEBREW_PREFIX, so Intel (/usr/local) prefixes work too.
GCLOUD_SDK_BIN="${HOMEBREW_PREFIX:-/opt/homebrew}/share/google-cloud-sdk/bin"
if [[ -d "$GCLOUD_SDK_BIN" ]]; then
  case ":$PATH:" in
    *":$GCLOUD_SDK_BIN:"*) ;;
    *) export PATH="$PATH:$GCLOUD_SDK_BIN" ;;
  esac
fi
unset GCLOUD_SDK_BIN

[ -f "$HOME/.cargo/env" ] && . "$HOME/.cargo/env"
