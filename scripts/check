#!/usr/bin/env bash
# The repository checks, in five groups: lint (ruff, ty), links (guidance links), md-budgets (Markdown line
# limits), leaks (private terms), and tests (pytest). CI runs one job per group, and `dotfiles-pr ship` runs all groups,
# so this file stays the one definition of "the checks".
# Usage: scripts/check [lint|links|md-budgets|leaks|tests]...  With no group, it runs every group.
# It runs every command in the chosen groups, so one run reports every failure, then exits 1 if any failed.
set -uo pipefail

cd "$(dirname "${BASH_SOURCE[0]}")/.." || exit 2

all_groups=(lint links md-budgets leaks tests)
groups=("$@")
(( ${#groups[@]} )) || groups=("${all_groups[@]}")

# Reject a typo before any check runs, so a misspelled group cannot pass by running nothing.
for group in "${groups[@]}"; do
  case " ${all_groups[*]} " in
    *" $group "*) ;;
    *) echo "scripts/check: unknown group '$group'. Use: ${all_groups[*]}" >&2; exit 2 ;;
  esac
done

failed=()
run() {
  uv run --frozen "$@" || failed+=("$*")
}

for group in "${groups[@]}"; do
  case "$group" in
    lint)
      run ruff check
      run ruff format --check
      run ty check
      ;;
    links)
      run python scripts/check_guidance_links.py
      ;;
    md-budgets)
      run python scripts/check_md_budgets.py
      ;;
    leaks)
      # The deny list is private: the work overlay, or the DOTFILES_LEAK_TERMS secret in CI. See scripts/check_leaks.py.
      run python scripts/check_leaks.py
      ;;
    tests)
      run pytest
      ;;
  esac
done

if (( ${#failed[@]} )); then
  echo >&2
  echo "scripts/check: ${#failed[@]} check(s) failed:" >&2
  printf '  - %s\n' "${failed[@]}" >&2
  exit 1
fi
