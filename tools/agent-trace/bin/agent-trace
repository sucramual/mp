#!/usr/bin/env python3
"""agent-trace: record agent run spans and show one joined timeline per ticket. See ../README.md.

This entry point is symlinked into ~/bin. It resolves its real path, puts the tool directory (its parent's parent)
on sys.path, and runs agent_trace.cli.main.
"""

from __future__ import annotations

import os
import sys

sys.path.insert(0, os.path.dirname(os.path.dirname(os.path.realpath(__file__))))

from agent_trace.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
